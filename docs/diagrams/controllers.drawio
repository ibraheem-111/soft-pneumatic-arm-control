groundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sum" target="law"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ndob" value="&lt;b&gt;Disturbance observer&lt;/b&gt; (NDOB)&lt;br&gt;d̂ = z + l₁ q̂&lt;br&gt;ż = l₁ (a q̂ − b v&lt;sub&gt;m&lt;/sub&gt; − d̂)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#DCEAF7;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="150" y="360" width="260" height="90" as="geometry"/></mxCell><mxCell id="c14" value="q̂" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sum" target="ndob"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="570" y="370"/><mxPoint x="570" y="405"/></Array></mxGeometry></mxCell><mxCell id="c15" value="v&lt;sub&gt;m&lt;/sub&gt; = H p&lt;sub&gt;m&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="model" target="ndob"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1079" y="570"/><mxPoint x="280" y="570"/></Array></mxGeometry></mxCell><mxCell id="c16" value="d̂" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ndob" target="law"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="255"/></Array></mxGeometry></mxCell><mxCell id="note" value="Code: softarm.controllers.DelayAwareNDOSMC(exact_preview=True) with the observer on. Nikoletta&#x27;s gains: λ = 4 s⁻¹, l₁ = 0.1, l₂ = 0, μ = 1 mm, Φ = 1, ε = 1. Same structure as the SMC page plus the observer, which acts on the predicted tip q̂.&lt;br&gt;&lt;br&gt;Blue: computed by the controller every 10 ms. Dashed: model run inside the controller. Grey: the simulator (make_calibrated_sim). Tip q in mm from the settled pose; pressures in psi." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="110" y="650" width="1300" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="MPC on M2" id="MPC_on_M2"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="MPC on M2, reference known" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="grp" value="Controller (every 10 ms; state X = (y, p) ∈ ℝ⁶, input u ∈ ℝ³)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7F7F7F;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontColor=#555555;arcSize=3;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="1250" height="560" as="geometry"/></mxCell><mxCell id="ref" value="Known trajectory&lt;br&gt;r(k), all k" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="85" width="150" height="50" as="geometry"/></mxCell><mxCell id="win" value="&lt;b&gt;Reference window&lt;/b&gt;&lt;br&gt;r(k+N) … r(k+N+H−1)&lt;br&gt;H = 25 / 100 / 300 steps = 0.25 / 1 / 3 s" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#DCEAF7;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="760" y="80" width="320" height="70" as="geometry"/></mxCell><mxCell id="c1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ref" target="win"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mpc" value="&lt;b&gt;Unconstrained MPC&lt;/b&gt; (closed form, first move only)&lt;br&gt;min Σ&lt;sub&gt;i&lt;/sub&gt; ‖C X(k+N+1+i) + w − r(k+N+i)‖² + R&lt;sub&gt;u&lt;/sub&gt; Σ&lt;sub&gt;i&lt;/sub&gt; ‖Δu(k+i)‖²&lt;br&gt;u(k) = g&lt;sub&gt;r&lt;/sub&gt; r + g&lt;sub&gt;x&lt;/sub&gt; X(k+N) + g&lt;sub&gt;w&lt;/sub&gt; w + g&lt;sub&gt;u&lt;/sub&gt; u(k−1)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#DCEAF7;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="640" y="190" width="470" height="110" as="geometry"/></mxCell><mxCell id="c2" value="r(k+N … k+N+H−1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="win" target="mpc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cmd" value="&lt;b&gt;Command&lt;/b&gt;&lt;br&gt;u&lt;sub&gt;cmd&lt;/sub&gt; = 4.5 + u(k)&lt;br&gt;clip 0–9 psi" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#DCEAF7;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="1150" y="205" width="140" height="80" as="geometry"/></mxCell><mxCell id="plant" value="&lt;b&gt;Plant&lt;/b&gt;: make_calibrated_sim&lt;br&gt;dead time T = 0.5 s&lt;br&gt;→ pneumatic lag τ ≈ 0.6 s&lt;br&gt;→ pouches → MuJoCo arm" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#E6E6E6;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1360" y="190" width="200" height="110" as="geometry"/></mxCell><mxCell id="out" value="tip q" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1580" y="225" width="50" height="40" as="geometry"/></mxCell><mxCell id="c3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mpc" target="cmd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c4" value="u (S2–S4)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmd" target="plant"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="plant" target="out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="state" value="&lt;b&gt;Measured state&lt;/b&gt; X(k)&lt;br&gt;y = tip − settled tip (mm)&lt;br&gt;p = S2–S4 segment pressure − settled (psi)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#DCEAF7;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="90" y="380" width="270" height="90" as="geometry"/></mxCell><mxCell id="pred" value="&lt;b&gt;Delay predictor&lt;/b&gt; (M2, zero-order hold, 10 ms)&lt;br&gt;X(k+N) = A&lt;sup&gt;N&lt;/sup&gt; X(k) + Σ&lt;sub&gt;i&lt;/sub&gt; A&lt;sup&gt;N−1−i&lt;/sup&gt; B u(k−N+i)&lt;br&gt;N = 50" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#DCEAF7;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="480" y="380" width="380" height="90" as="geometry"/></mxCell><mxCell id="buf" value="&lt;b&gt;Command buffer&lt;/b&gt;&lt;br&gt;u(k−N) … u(k−1)&lt;br&gt;(clipped, as applied)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#FFFFFF;strokeColor=#1F4E79;dashed=1;" vertex="1" parent="1"><mxGeometry x="960" y="385" width="200" height="80" as="geometry"/></mxCell><mxCell id="off" value="&lt;b&gt;Model-error offset&lt;/b&gt;&lt;br&gt;w ← w + α [(y(k) − ŷ(k | k−N)) − w]&lt;br&gt;ŷ(k | k−N) = C X(k) predicted N steps ago&lt;br&gt;α: low-pass, 0.5 s" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#DCEAF7;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="90" y="190" width="320" height="100" as="geometry"/></mxCell><mxCell id="c6" value="X(k)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="state" target="pred"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="buf" target="pred"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="u(k) applied" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmd" target="buf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1220" y="340"/><mxPoint x="1110" y="340"/></Array></mxGeometry></mxCell><mxCell id="c9" value="X(k+N)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.6;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pred" target="mpc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="708" y="340"/><mxPoint x="757" y="340"/></Array></mxGeometry></mxCell><mxCell id="c10" value="y(k)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="state" target="off"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="C X(k+N), stored" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.1;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pred" target="off"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="518" y="330"/><mxPoint x="362" y="330"/></Array></mxGeometry></mxCell><mxCell id="c12" value="w" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="off" target="mpc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="tip, segment pressures (S2–S4)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="plant" target="state"><mxGeometry relative="1" as="geometry" x="-0.3"><Array as="points"><mxPoint x="1460" y="580"/><mxPoint x="225" y="580"/></Array></mxGeometry></mxCell><mxCell id="note" value="Code: softarm.controllers.DelayMPC on softarm.models.M2. M2: τ ṗ = −p + G u(t−T), ẏ = −Λ y + Λ H p (docs/figures/task_space_model.json). R&lt;sub&gt;u&lt;/sub&gt; tuned per horizon on a 5 mm, 0.07 Hz circle (chosen 10⁻⁵ mm²/psi²; also run at R&lt;sub&gt;u&lt;/sub&gt; = 1 and 10). Clipping is not in the optimisation; the clipped command enters the buffer.&lt;br&gt;&lt;br&gt;Blue: computed by the controller every 10 ms. Dashed: model run inside the controller. Grey: the simulator (make_calibrated_sim). Tip q in mm from the settled pose; pressures in psi." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="1250" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="MPC on F" id="MPC_on_F"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="MPC on F (frequency-identified model), reference known" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="grp" value="Controller (every 10 ms), one copy per planar channel: x and y; model F per channel (models/sysid_calibrated_v2.json)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7F7F7F;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontColor=#555555;arcSize=3;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="1250" height="560" as="geometry"/></mxCell><mxCell id="ref" value="Known trajectory&lt;br&gt;r(k), all k" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="85" width="150" height="50" as="geometry"/></mxCell><mxCell id="win" value="&lt;b&gt;Reference window&lt;/b&gt;&lt;br&gt;r(k+d) … r(k+d+H−1)&lt;br&gt;H = 300 steps = 3 s, d = 50" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#DCEAF7;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="760" y="80" width="300" height="70" as="geometry"/></mxCell><mxCell id="c1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ref" target="win"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mpc" value="&lt;b&gt;Unconstrained MPC&lt;/b&gt; (closed form, first move only)&lt;br&gt;min Σ&lt;sub&gt;i&lt;/sub&gt; (C x(k+d+1+i) + o − r(k+d+i))² + ρ Σ&lt;sub&gt;i&lt;/sub&gt; Δu(k+i)²&lt;br&gt;ρ = 10⁻⁵ m²/psi²" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#DCEAF7;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="640" y="190" width="440" height="100" as="geometry"/></mxCell><mxCell id="c2" value="r(k+d … k+d+H−1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="win" target="mpc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="map" value="&lt;b&gt;Channels → segments&lt;/b&gt;&lt;br&gt;S2 = 4.5 + u&lt;sub&gt;y&lt;/sub&gt;/2&lt;br&gt;S3 = 4.5 − u&lt;sub&gt;x&lt;/sub&gt;&lt;br&gt;S4 = 4.5 − u&lt;sub&gt;y&lt;/sub&gt;/2&lt;br&gt;clip 0–9 psi" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#DCEAF7;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="1120" y="180" width="160" height="120" as="geometry"/></mxCell><mxCell id="plant" value="&lt;b&gt;Plant&lt;/b&gt;: make_calibrated_sim&lt;br&gt;dead time T = 0.5 s&lt;br&gt;→ pneumatic lag τ ≈ 0.6 s&lt;br&gt;→ pouches → MuJoCo arm" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#E6E6E6;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1360" y="185" width="200" height="110" as="geometry"/></mxCell><mxCell id="out" value="tip q" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1580" y="220" width="50" height="40" as="geometry"/></mxCell><mxCell id="c3" value="u&lt;sub&gt;x&lt;/sub&gt;, u&lt;sub&gt;y&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mpc" target="map"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c4" value="S2–S4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="map" target="plant"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="plant" target="out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="chan" value="&lt;b&gt;Channel pressures&lt;/b&gt;&lt;br&gt;p&lt;sub&gt;x&lt;/sub&gt; = −mean(S3 pouches)&lt;br&gt;p&lt;sub&gt;y&lt;/sub&gt; = mean(S2 − S4 pouches)&lt;br&gt;(5 pouches each)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#DCEAF7;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="90" y="400" width="220" height="100" as="geometry"/></mxCell><mxCell id="kf" value="&lt;b&gt;Kalman filter&lt;/b&gt; on [x; tip offset o]&lt;br&gt;measurements: tip, channel pressure&lt;br&gt;x&lt;sub&gt;1&lt;/sub&gt; = channel pressure" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#DCEAF7;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="350" y="400" width="270" height="100" as="geometry"/></mxCell><mxCell id="pred" value="&lt;b&gt;Delay predictor&lt;/b&gt;&lt;br&gt;x(k+d) = A&lt;sub&gt;d&lt;/sub&gt;&lt;sup&gt;d&lt;/sup&gt; x(k) + Σ&lt;sub&gt;i&lt;/sub&gt; A&lt;sub&gt;d&lt;/sub&gt;&lt;sup&gt;d−1−i&lt;/sup&gt; B&lt;sub&gt;d&lt;/sub&gt; u(k−d+i)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#DCEAF7;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="660" y="405" width="300" height="90" as="geometry"/></mxCell><mxCell id="buf" value="&lt;b&gt;Command buffer&lt;/b&gt;&lt;br&gt;applied channel commands&lt;br&gt;u&lt;sub&gt;x&lt;/sub&gt; = 4.5 − S3, u&lt;sub&gt;y&lt;/sub&gt; = S2 − S4" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#FFFFFF;strokeColor=#1F4E79;dashed=1;" vertex="1" parent="1"><mxGeometry x="1010" y="405" width="220" height="90" as="geometry"/></mxCell><mxCell id="c6" value="p&lt;sub&gt;x&lt;/sub&gt;, p&lt;sub&gt;y&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="chan" target="kf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="x(k)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="kf" target="pred"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="buf" target="pred"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="u(k−d) (time update)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="buf" target="kf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="540"/><mxPoint x="485" y="540"/></Array></mxGeometry></mxCell><mxCell id="c10" value="applied (after clip)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="map" target="buf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="350"/><mxPoint x="1175" y="350"/></Array></mxGeometry></mxCell><mxCell id="c11" value="x(k+d)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pred" target="mpc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="340"/><mxPoint x="772" y="340"/></Array></mxGeometry></mxCell><mxCell id="c12" value="offset o" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.05;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="kf" target="mpc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="485" y="340"/><mxPoint x="662" y="340"/></Array></mxGeometry></mxCell><mxCell id="c13" value="pouch pressures" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="plant" target="chan"><mxGeometry relative="1" as="geometry" x="-0.4"><Array as="points"><mxPoint x="1460" y="590"/><mxPoint x="200" y="590"/></Array></mxGeometry></mxCell><mxCell id="c14" value="tip x, y" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="plant" target="kf"><mxGeometry relative="1" as="geometry" x="-0.3"><Array as="points"><mxPoint x="1400" y="570"/><mxPoint x="417" y="570"/></Array></mxGeometry></mxCell><mxCell id="note" value="Code: softarm.controllers.KalmanDelayMPC(preview=&quot;oracle&quot;) with the true future reference, as built by softarm.controllers.known_reference. F: per-channel state-space model x&lt;sub&gt;n+1&lt;/sub&gt; = A&lt;sub&gt;d&lt;/sub&gt; x&lt;sub&gt;n&lt;/sub&gt; + B&lt;sub&gt;d&lt;/sub&gt; u&lt;sub&gt;n−d&lt;/sub&gt; identified from frequency responses (scripts/sysid_frf.py). Unlike M2, F does not model z and treats x and y as independent channels.&lt;br&gt;&lt;br&gt;Blue: computed by the controller every 10 ms. Dashed: model run inside the controller. Grey: the simulator (make_calibrated_sim). Tip q in mm from the settled pose; pressures in psi." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="1250" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
