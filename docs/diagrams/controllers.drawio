&gt;&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#000000;strokeWidth=1;fontSize=11;fontStyle=2;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="lp"><mxGeometry relative="1" as="geometry" x="0.0" y="-10"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#000000;strokeWidth=1;fontSize=11;fontStyle=2;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lp" target="out_w"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note" value="&lt;i&gt;A&lt;/i&gt;, &lt;i&gt;B&lt;/i&gt;, &lt;i&gt;C&lt;/i&gt;: the model discretised with a zero-order hold at 10 ms; &lt;i&gt;α&lt;/i&gt; = 1 − e&lt;sup&gt;−0.01/0.5&lt;/sup&gt;." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="700" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="SMC known ref" id="SMC_known_ref"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Delay-aware SMC (M2), reference known" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="grp" value="Controller (every 10 ms, per axis x, y, z)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7F7F7F;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontColor=#555555;arcSize=3;" vertex="1" parent="1"><mxGeometry x="110" y="70" width="1300" height="560" as="geometry"/></mxCell><mxCell id="ref" value="Known trajectory&lt;br&gt;r(t), all t" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="150" y="95" width="150" height="60" as="geometry"/></mxCell><mxCell id="look" value="&lt;b&gt;Look-ahead&lt;/b&gt;&lt;br&gt;r(t+T), ṙ(t+T) read from the trajectory&lt;br&gt;T = 0.5 s (N = 50 steps)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#DCEAF7;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="480" y="90" width="290" height="70" as="geometry"/></mxCell><mxCell id="c1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ref" target="look"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="law" value="&lt;b&gt;Sliding-mode law&lt;/b&gt;&lt;br&gt;σ = q̂ − r(t+T)&lt;br&gt;v = [ṙ(t+T) + a q̂ − λσ − η sat(σ/μ)] / b&lt;br&gt;η = ε" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#DCEAF7;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="450" y="200" width="350" height="110" as="geometry"/></mxCell><mxCell id="c2" value="r(t+T), ṙ(t+T)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="look" target="law"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="alloc" value="&lt;b&gt;Allocation&lt;/b&gt;&lt;br&gt;p&lt;sub&gt;des&lt;/sub&gt; = H⁻¹ v" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#DCEAF7;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="860" y="220" width="120" height="70" as="geometry"/></mxCell><mxCell id="laginv" value="&lt;b&gt;Lag inverse&lt;/b&gt;&lt;br&gt;p&lt;sub&gt;cmd&lt;/sub&gt; = p&lt;sub&gt;des&lt;/sub&gt; + τ ṗ&lt;sub&gt;des&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#DCEAF7;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="1050" y="220" width="140" height="70" as="geometry"/></mxCell><mxCell id="cmd" value="&lt;b&gt;Command&lt;/b&gt;&lt;br&gt;u = 4.5 + p&lt;sub&gt;cmd&lt;/sub&gt; / G&lt;br&gt;clip 0–9 psi" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#DCEAF7;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="1240" y="215" width="150" height="80" as="geometry"/></mxCell><mxCell id="plant" value="&lt;b&gt;Plant&lt;/b&gt;: make_calibrated_sim&lt;br&gt;dead time T = 0.5 s&lt;br&gt;→ pneumatic lag τ ≈ 0.6 s&lt;br&gt;→ pouches → MuJoCo arm" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#E6E6E6;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1480" y="200" width="200" height="110" as="geometry"/></mxCell><mxCell id="out" value="tip q" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1700" y="235" width="50" height="40" as="geometry"/></mxCell><mxCell id="c3" value="v" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="law" target="alloc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c4" value="p&lt;sub&gt;des&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="alloc" target="laginv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="laginv" target="cmd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="u (S2–S4)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmd" target="plant"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="plant" target="out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="model" value="&lt;b&gt;Delay-free M2&lt;/b&gt; (Smith predictor)&lt;br&gt;τ ṗ&lt;sub&gt;m&lt;/sub&gt; = −p&lt;sub&gt;m&lt;/sub&gt; + G (u − 4.5)&lt;br&gt;ẋ&lt;sub&gt;m&lt;/sub&gt; = −a x&lt;sub&gt;m&lt;/sub&gt; + b H p&lt;sub&gt;m&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#FFFFFF;strokeColor=#1F4E79;dashed=1;" vertex="1" parent="1"><mxGeometry x="1050" y="380" width="290" height="90" as="geometry"/></mxCell><mxCell id="c8" value="u sent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jum