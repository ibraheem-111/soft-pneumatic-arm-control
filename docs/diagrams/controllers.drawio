ts"><mxPoint x="185" y="180"/><mxPoint x="340" y="180"/></Array></mxGeometry></mxCell><mxCell id="c23" value="&lt;i&gt;w&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.55;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="offset" target="mpc"><mxGeometry relative="1" as="geometry" x="0.6" y="0.0"><Array as="points"><mxPoint x="510" y="195"/><mxPoint x="448" y="195"/></Array></mxGeometry></mxCell><mxCell id="c24" value="&lt;span style=&quot;text-decoration:overline&quot;&gt;&lt;i&gt;δ&lt;/i&gt;&lt;/span&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;−1&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.9;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dtap" target="mpc"><mxGeometry relative="1" as="geometry" x="0.3" y="0.0"><Array as="points"><mxPoint x="700" y="165"/><mxPoint x="543" y="165"/></Array></mxGeometry></mxCell><mxCell id="note" value="Δ&lt;i&gt;t&lt;/i&gt; = 10 ms; horizon &lt;i&gt;H&lt;/i&gt; = 100 steps (1 s); &lt;i&gt;R&lt;/i&gt;&lt;sub&gt;&lt;i&gt;u&lt;/i&gt;&lt;/sub&gt; = 0.1 mm²/psi²; &lt;i&gt;τ&lt;/i&gt; = 0.60 s; &lt;i&gt;G&lt;/i&gt; = 1; &lt;i&gt;a&lt;/i&gt;&lt;sub&gt;&lt;i&gt;x&lt;/i&gt;&lt;/sub&gt; = 4.66 s⁻¹, &lt;i&gt;a&lt;/i&gt;&lt;sub&gt;&lt;i&gt;y&lt;/i&gt;&lt;/sub&gt; = 4.69 s⁻¹; &lt;i&gt;H&lt;/i&gt; ∈ ℝ&lt;sup&gt;2×4&lt;/sup&gt; (≈ 1.84 mm/psi); &lt;i&gt;P&lt;/i&gt; = [1 0 −1 0; 0 1 0 −1]&lt;sup&gt;T&lt;/sup&gt; maps (&lt;i&gt;δ&lt;/i&gt;&lt;sub&gt;&lt;i&gt;x&lt;/i&gt;&lt;/sub&gt;, &lt;i&gt;δ&lt;/i&gt;&lt;sub&gt;&lt;i&gt;y&lt;/i&gt;&lt;/sub&gt;) to S1–S4; &lt;i&gt;α&lt;/i&gt; = 1 − e&lt;sup&gt;−Δ&lt;i&gt;t&lt;/i&gt;/0.5 s&lt;/sup&gt;; each segment command drives its five pouches." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="90" y="400" width="1240" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="MPC M2 submission (Simulink)" id="MPC_M2_submission_(Simulink)"><mxGraphModel dx="1150" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="600" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="in_r" value="1" style="rounded=1;arcSize=40;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;shadow=1;fontSize=10;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="30" height="16" as="geometry"/></mxCell><mxCell id="in_r_name" value="&lt;i&gt;r&lt;/i&gt;(&lt;i&gt;t&lt;/i&gt;)" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="-10" y="70" width="90" height="16" as="geometry"/></mxCell><mxCell id="prev" value="Reference&lt;br&gt;preview" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;shadow=1;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="80" y="35" width="120" height="50" as="geometry"/></mxCell><mxCell id="prev_name" value="&lt;i&gt;R&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; = &lt;i&gt;r&lt;/i&gt;(&lt;i&gt;t&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; + &lt;i&gt;i&lt;/i&gt;Δ&lt;i&gt;t&lt;/i&gt;), &lt;i&gt;i&lt;/i&gt; = 1…100" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="50" y="87" width="180" height="16" as="g