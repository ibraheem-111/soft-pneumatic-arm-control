  </diagram><diagram name="MPC M2 submission (IEEE)" id="MPC_M2_submission_(IEEE)"><mxGraphModel dx="1450" dy="470" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="470" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ref" value="&lt;i&gt;r&lt;/i&gt;(&lt;i&gt;t&lt;/i&gt;)" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0" y="55" width="40" height="30" as="geometry"/></mxCell><mxCell id="prev" value="Reference preview&lt;br&gt;&lt;i&gt;R&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; = [ &lt;i&gt;r&lt;/i&gt;(&lt;i&gt;t&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; + &lt;i&gt;i&lt;/i&gt;Δ&lt;i&gt;t&lt;/i&gt;) ], &lt;i&gt;i&lt;/i&gt; = 1 … &lt;i&gt;N&lt;/i&gt;&lt;sub&gt;p&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontSize=14;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="38" width="190" height="64" as="geometry"/></mxCell><mxCell id="mpc" value="Unconstrained MPC (first move)&lt;br&gt;&lt;i&gt;δ&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; = &lt;i&gt;g&lt;/i&gt;&lt;sub&gt;&lt;i&gt;r&lt;/i&gt;&lt;/sub&gt;&lt;i&gt;R&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; + &lt;i&gt;g&lt;/i&gt;&lt;sub&gt;&lt;i&gt;x&lt;/i&gt;&lt;/sub&gt;&lt;i&gt;X&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; + &lt;i&gt;g&lt;/i&gt;&lt;sub&gt;&lt;i&gt;w&lt;/i&gt;&lt;/sub&gt;&lt;i&gt;w&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; + &lt;i&gt;g&lt;/i&gt;&lt;sub&gt;&lt;i&gt;u&lt;/i&gt;&lt;/sub&gt;&lt;span style=&quot;text-decoration:overline&quot;&gt;&lt;i&gt;δ&lt;/i&gt;&lt;/span&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;−1&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontSize=14;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="32" width="270" height="76" as="geometry"/></mxCell><mxCell id="alloc" value="Pair allocation&lt;br&gt;4.5 + &lt;i&gt;P&lt;/i&gt;&lt;i&gt;δ&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontSize=14;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="610" y="38" width="120" height="64" as="geometry"/></mxCell><mxCell id="sat" value="&lt;br&gt;&lt;br&gt;[0, 9] psi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontSize=14;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="770" y="38" width="80" height="64" as="geometry"/></mxCell><mxCell id="c1" style="endArrow=classic;endSize=3;html=1;strokeColor=#000000;rounded=0;strokeWidth=0.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="788.0" y="62.0" as="sourcePoint"/><mxPoint x="832.0" y="62.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c2" style="endArrow=classic;endSize=3;html=1;strokeColor=#000000;rounded=0;strokeWidth=0.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810.0" y="76.0" as="sourcePoint"/><mxPoint x="810.0" y="46.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c3" style="endArrow=none;html=1;strokeColor=#000000;rounded=0;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790.0" y="72.0" as="sourcePoint"/><mxPoint x="830.0" y="52.0" as="targetPoint"/><Array as="points"><mxPoint x="801.0" y="72.0"/><mxPoint x="819.0" y="52.0"/></Array></mxGeometry></mxCell><mxCell id="plant" value="Plant (&lt;span style=&quot;font-family:Courier New&quot;&gt;make_sim&lt;/span&gt;)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontSize=14;fontFamily=Times New Roman;fontCol