  <diagram name="MPC on F" id="MPC_on_F">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="MPC on F (frequency-identified model), reference known" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="grp" value="Controller (every 10 ms), one copy per planar channel: x and y; model F per channel (models/sysid_calibrated_v2.json)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7F7F7F;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontColor=#555555;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="60" y="70" width="1250" height="560" as="geometry" />
        </mxCell>
        <mxCell id="ref" value="Known trajectory&lt;br&gt;r(k), all k" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="85" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="win" value="&lt;b&gt;Reference window&lt;/b&gt;&lt;br&gt;r(k+d) … r(k+d+H−1)&lt;br&gt;H = 300 steps = 3 s, d = 50" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#DCEAF7;strokeColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="760" y="80" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ref" target="win">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mpc" value="&lt;b&gt;Unconstrained MPC&lt;/b&gt; (closed form, first move only)&lt;br&gt;min Σ&lt;sub&gt;i&lt;/sub&gt; (C x(k+d+1+i) + o − r(k+d+i))² + ρ Σ&lt;sub&gt;i&lt;/sub&gt; Δu(k+i)²&lt;br&gt;ρ = 10⁻⁵ m²/psi²" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#DCEAF7;strokeColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="640" y="190" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="r(k+d … k+d+H−1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="win" target="mpc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="map" value="&lt;b&gt;Channels → segments&lt;/b&gt;&lt;br&gt;S2 = 4.5 + u&lt;sub&gt;y&lt;/sub&gt;/2&lt;br&gt;S3 = 4.5 − u&lt;sub&gt;x&lt;/sub&gt;&lt;br&gt;S4 = 4.5 − u&lt;sub&gt;y&lt;/sub&gt;/2&lt;br&gt;clip 0–9 psi" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#DCEAF7;strokeColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="1120" y="180" width="160" height="120" as="geometry" />
        </mxCell>
        <mxCell id="plant" value="&lt;b&gt;Plant&lt;/b&gt;: make_calibrated_sim&lt;br&gt;dead time T = 0.5 s&lt;br&gt;→ pneumatic lag τ ≈ 0.6 s&lt;br&gt;→ pouches → MuJoCo arm" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#E6E6E6;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1360" y="185" width="200" height="110" as="geometry" />
