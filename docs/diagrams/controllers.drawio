ryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mpc" target="alloc"><mxGeometry relative="1" as="geometry" x="0.0" y="-12"></mxGeometry></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="alloc" target="sat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;i&gt;u&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=none;" edge="1" parent="1" source="sat" target="utap"><mxGeometry relative="1" as="geometry" x="0.0" y="-12"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="utap" target="plant"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=none;" edge="1" parent="1" source="plant" target="ytap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ytap" target="y"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="state" value="State&lt;br&gt;&lt;i&gt;X&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; = ( &lt;i&gt;y&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt;, &lt;i&gt;p&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; − 4.5 )" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontSize=14;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="90" y="240" width="190" height="60" as="geometry"/></mxCell><mxCell id="offset" value="Offset estimator&lt;br&gt;&lt;i&gt;e&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; = &lt;i&gt;y&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; − &lt;i&gt;C&lt;/i&gt;(&lt;i&gt;A&lt;/i&gt;&lt;i&gt;X&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;−1&lt;/sub&gt; + &lt;i&gt;B&lt;/i&gt;&lt;span style=&quot;text-decoration:overline&quot;&gt;&lt;i&gt;δ&lt;/i&gt;&lt;/span&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;−1&lt;/sub&gt;)&lt;br&gt;&lt;i&gt;w&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; = &lt;i&gt;w&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;−1&lt;/sub&gt; + &lt;i&gt;α&lt;/i&gt;(&lt;i&gt;e&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; − &lt;i&gt;w&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;−1&lt;/sub&gt;)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontSize=14;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="360" y="228" width="300" height="84" as="geometry"/></mxCell><mxCell id="z1" value="&lt;i&gt;z&lt;/i&gt;&lt;sup&gt;−1&lt;/sup&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontSize=14;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="740" y="248" width="50" height="44" as="geometry"/></mxCell><mxCell id="rec" value="Applied correction&lt;br&gt;&lt;span style=&quot;text-decoration:overline&quot;&gt;&lt;i&gt;δ&lt;/i&gt;&lt;/span&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; = ½ ( &lt;i&gt;u&lt;/i&gt;&lt;sub&gt;1&lt;/sub&gt; − &lt;i&gt;u&lt;/i&gt;&lt;sub&gt;3&lt;/sub&gt;, &lt;i&gt;u&lt;/i&gt;&lt;sub&gt;2&lt;/sub&gt; − &lt;i&gt;u&lt;/i&gt;&lt;sub&gt;4&lt;/sub&gt; )" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontSize=14;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="830" y="240" width="200" height="60" as="geometry"/></mxCell><mxCell id="dtap" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="697" y="267" width="6" height="6" as="geometry"/></mxCell><mxCell id="c12" value="&lt;i&gt;y&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; (tip position)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ytap" target="state"><mxGeometry relative="1" as="geometry" x="0.55" y="-12"><Array as="points"><mxPoint x="1350" y="385"/><mxPoint x="147" y="385"/></Array></mxGeometry></mxCell><mxCell id="c13" value="&lt;i&gt;p&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; (segment pressure sensors)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="plant" target="state"><mxGeometry relative="1" as="geometry" x="0.25" y="-12"><Array as="points"><mxPoint x="1060" y="360"/><mxPoint x="223" y="360"/></Array></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.275;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="utap" target="rec"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="885" y="240"/></Array></mxGeometry></mxCell><mxCell id="c15" value="&lt;span style=&quot;text-decoration:overline&quot;&gt;&lt;i&gt;δ&lt;/i&gt;&lt;/span&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rec" target="z1"><mxGeometry relative="1" as="geometry" x="0.0" y="-12"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=none;" edge="1" parent="1" source="z1" target="dtap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;span style=&quot;text-decoration:overline&quot;&gt;&lt;i&gt;δ&lt;/i&gt;&lt;/span&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;−1&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dtap" target="offset"><mxGeometry relative="1" as="geometry" x="0.0" y="14"></mxGeometry></mxCell><mxCell id="c18" value="&lt;i&gt;X&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="state" target="offset"><mxGeometry relative="1" as="geometry" x="0.0" y="-12"></mxGeometry></mxCell><mxCell id="c19" value="&lt;i&gt;X&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.15;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="state" target="mpc"><mxGeometry relative="1" as="geometry" x="0.85" y="0.0"><Array as="points"><mxPoint x="185" y="180"/><mxPoint x="340" y="180"/></Array></mxGeometry></mxCell><mxCell id="c20" value="&lt;i&gt;w&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.55;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="offset" target="mpc"><mxGeometry relative="1" as="geometry" x="0.6" y="0.0"><Array as="points"><mxPoint x="510" y="195"/><mxPoint x="448" y="195"/></Array></mxGeometry></mxCell><mxCell id="c21" value="&lt;span style=&quot;text-decoration:overline&quot;&gt;&lt;i&gt;δ&lt;/i&gt;&lt;/span&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;−1&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.9;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dtap" target="mpc"><mxGeometry relative="1" as="geometry" x="0.3" y="0.0"><Array as="points"><mxPoint x="700" y="165"/><mxPoint x="543" y="165"/></Array></mxGeometry></mxCell><mxCell id="note" value="Δ&lt;i&gt;t&lt;/i&gt; = 10 ms; prediction horizon &lt;i&gt;N&lt;/i&gt;&lt;sub&gt;p&lt;/sub&gt; = 100 steps (1 s); &lt;i&gt;R&lt;/i&gt;&lt;sub&gt;&lt;i&gt;u&lt;/i&gt;&lt;/sub&gt; = 0.1 mm²/psi²; &lt;i&gt;P&lt;/i&gt; = [1 0 −1 0; 0 1 0 −1]&lt;sup&gt;T&lt;/sup&gt; maps (&lt;i&gt;δ&lt;/i&gt;&lt;sub&gt;&lt;i&gt;x&lt;/i&gt;&lt;/sub&gt;, &lt;i&gt;δ&lt;/i&gt;&lt;sub&gt;&lt;i&gt;y&lt;/i&gt;&lt;/sub&gt;) to S1–S4; &lt;i&gt;α&lt;/i&gt; = 1 − e&lt;sup&gt;−Δ&lt;i&gt;t&lt;/i&gt;/0.5 s&lt;/sup&gt;; each segment command drives its five pouches. Controller&#x27;s internal model (M2, in &lt;i&gt;A&lt;/i&gt;, &lt;i&gt;B&lt;/i&gt;, &lt;i&gt;C&lt;/i&gt; and the gains): &lt;i&gt;p&lt;/i&gt; = &lt;i&gt;G&lt;/i&gt;/(&lt;i&gt;τ&lt;/i&gt;&lt;i&gt;s&lt;/i&gt; + 1) &lt;i&gt;u&lt;/i&gt;, &lt;i&gt;y&lt;/i&gt;&lt;sub&gt;&lt;i&gt;i&lt;/i&gt;&lt;/sub&gt; = &lt;i&gt;a&lt;/i&gt;&lt;sub&gt;&lt;i&gt;i&lt;/i&gt;&lt;/sub&gt;/(&lt;i&gt;s&lt;/i&gt; + &lt;i&gt;a&lt;/i&gt;&lt;sub&gt;&lt;i&gt;i&lt;/i&gt;&lt;/sub&gt;) (&lt;i&gt;H&lt;/i&gt;&lt;i&gt;p&lt;/i&gt;)&lt;sub&gt;&lt;i&gt;i&lt;/i&gt;&lt;/sub&gt;; &lt;i&gt;τ&lt;/i&gt; = 0.60 s, &lt;i&gt;G&lt;/i&gt; = 1, &lt;i&gt;a&lt;/i&gt;&lt;sub&gt;&lt;i&gt;x&lt;/i&gt;&lt;/sub&gt; = 4.66 s⁻¹, &lt;i&gt;a&lt;/i&gt;&lt;sub&gt;&lt;i&gt;y&lt;/i&gt;&lt;/sub&gt; = 4.69 s⁻¹, pressure map &lt;i&gt;H&lt;/i&gt; ∈ ℝ&lt;sup&gt;2×4&lt;/sup&gt; (≈ 1.84 mm/psi)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="90" y="400" width="1240" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="MPC M2 submission (Simulink)" id="MPC_M2_submission_(Simulink)"><mxGraphModel dx="1150" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="600" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="in_r" value="1" style="rounded=1;arcSize=40;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;shadow=1;fontSize=10;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="30" height="16" as="geometry"/></mxCell><mxCell id="in_r_name" value="&lt;i&gt;r&lt;/i&gt;(&lt;i&gt;t&lt;/i&gt;)" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="-10" y="70" width="90" height="16" as="geometry"/></mxCell><mxCell id="prev" value="Reference&lt;br&gt;preview" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;shadow=1;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="80" y="35" width="120" height="50" as="geometry"/></mxCell><mxCell id="prev_name" value="&lt;i&gt;R&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; = &lt;i&gt;r&lt;/i&gt;(&lt;i&gt;t&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; + &lt;i&gt;i&lt;/i&gt;Δ&lt;i&gt;t&lt;/i&gt;), &lt;i&gt;i&lt;/i&gt; = 1…&lt;i&gt;N&lt;/i&gt;&lt;sub&gt;p&lt;/sub&gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="50" y="87" width="180" height="16" as="geometry"/></mxCell><mxCell id="gr" value="&lt;i&gt;g&lt;sub&gt;r&lt;/sub&gt;&lt;/i&gt;" style="trian