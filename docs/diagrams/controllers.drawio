ell id="c15" value="&lt;span style=&quot;text-decoration:overline&quot;&gt;&lt;i&gt;δ&lt;/i&gt;&lt;/span&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;−&lt;i&gt;N&lt;/i&gt; … &lt;i&gt;k&lt;/i&gt;−1&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="buf" target="pred"><mxGeometry relative="1" as="geometry" x="-0.1" y="-12"></mxGeometry></mxCell><mxCell id="c16" value="&lt;span style=&quot;text-decoration:overline&quot;&gt;&lt;i&gt;δ&lt;/i&gt;&lt;/span&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;−1&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.912;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="buf" target="mpc"><mxGeometry relative="1" as="geometry" x="-0.2" y="0.0"><Array as="points"><mxPoint x="740" y="160"/><mxPoint x="650" y="160"/></Array></mxGeometry></mxCell><mxCell id="c17" value="&lt;i&gt;X&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="state" target="pred"><mxGeometry relative="1" as="geometry" x="-0.3" y="0.0"><Array as="points"><mxPoint x="135" y="240"/></Array></mxGeometry></mxCell><mxCell id="c18" value="&lt;i&gt;X̂&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;+&lt;i&gt;N&lt;/i&gt;&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=0.515;exitY=0;exitDx=0;exitDy=0;entryX=0.176;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pred" target="mpc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;i&gt;X̂&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;+&lt;i&gt;N&lt;/i&gt;&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=0.606;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pred" target="zN"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;i&gt;X̂&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;|&lt;i&gt;k&lt;/i&gt;−&lt;i&gt;N&lt;/i&gt;&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="zN" target="offset"><mxGeometry relative="1" as="geometry" x="0.0" y="-14"></mxGeometry></mxCell><mxCell id="c21" value="&lt;i&gt;w&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=0.103;exitY=0;exitDx=0;exitDy=0;entryX=0.691;entryY=1;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="offset" target="mpc"><mxGeometry relative="1" as="geometry" x="-0.55" y="0.0"></mxGeometry></mxCell><mxCell id="ybr" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="837" y="497" width="6" height="6" as="geometry"/></mxCell><mxCell id="c22" value="&lt;i&gt;p&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; (S2–S4 segment pressure sensors)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=0.864;exitY=1;exitDx=0;exitDy=0;entryX=0.789;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="plant" target="state"><mxGeometry relative="1" as="geometry" x="0.6" y="-12"><Array as="points"><mxPoint x="1130" y="470"/><mxPoint x="190" y="470"/></Array></mxGeometry></mxCell><mxCell id="c23" value="&lt;i&gt;y&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; (tip position &lt;i&gt;x&lt;/i&gt;, &lt;i&gt;y&lt;/i&gt;, &lt;i&gt;z&lt;/i&gt;)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.263;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ytap" target="state"><mxGeometry relative="1" as="geometry" x="0.5" y="-12"><Array as="points"><mxPoint x="1210" y="500"/><mxPoint x="90" y="500"/></Array></mxGeometry></mxCell><mxCell id="c24" value="&lt;i&gt;y&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.882;entryY=1;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="ybr" target="offset"><mxGeometry relative="1" as="geometry" x="0.5" y="0.0"></mxGeometry></mxCell><mxCell id="note" value="Δ&lt;i&gt;t&lt;/i&gt; = 10 ms; dead time &lt;i&gt;N&lt;/i&gt; = 50 steps (0.5 s); prediction horizon &lt;i&gt;N&lt;/i&gt;&lt;sub&gt;p&lt;/sub&gt; = 100 steps (1 s); &lt;i&gt;R&lt;/i&gt;&lt;sub&gt;&lt;i&gt;u&lt;/i&gt;&lt;/sub&gt; = 10&lt;sup&gt;−5&lt;/sup&gt; mm²/psi²; &lt;i&gt;α&lt;/i&gt; = 1 − e&lt;sup&gt;−Δ&lt;i&gt;t&lt;/i&gt;/0.5 s&lt;/sup&gt;. &lt;i&gt;u&lt;/i&gt;, &lt;i&gt;δ&lt;/i&gt;, &lt;span style=&quot;text-decoration:overline&quot;&gt;&lt;i&gt;δ&lt;/i&gt;&lt;/span&gt; ∈ ℝ³ (segments S2–S4; S1 is a sealed reservoir), each segment command drives its five pouches; &lt;i&gt;y&lt;/i&gt; = tip (&lt;i&gt;x&lt;/i&gt;, &lt;i&gt;y&lt;/i&gt;, &lt;i&gt;z&lt;/i&gt;) in mm. &lt;i&gt;y&lt;/i&gt;&lt;sub&gt;0&lt;/sub&gt;, &lt;i&gt;p&lt;/i&gt;&lt;sub&gt;0&lt;/sub&gt;: tip and pressures at the first step. The &lt;i&gt;z&lt;/i&gt; row of &lt;i&gt;R&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; is set to &lt;i&gt;C&lt;/i&gt;&lt;i&gt;X̂&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;+&lt;i&gt;N&lt;/i&gt;&lt;/sub&gt; + &lt;i&gt;w&lt;/i&gt; (&lt;i&gt;z&lt;/i&gt; is predicted, not tracked); &lt;i&gt;w&lt;/i&gt; = 0 for the first &lt;i&gt;N&lt;/i&gt; steps. The 0.5 s transport delay is inside the plant. Controller&#x27;s internal model (M2, identified on &lt;span style=&quot;font-family:Courier New&quot;&gt;make_calibrated_sim&lt;/span&gt;): &lt;i&gt;τ&lt;/i&gt; = 0.60 s, &lt;i&gt;G&lt;/i&gt; = (1.12, 1.10, 1.16), &lt;i&gt;a&lt;/i&gt; = (4.77, 4.70, 15.49) s⁻¹, pressure map &lt;i&gt;H&lt;/i&gt; ∈ ℝ&lt;sup&gt;3×3&lt;/sup&gt;." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="535" width="1220" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="simplified_MPC" id="_2Jongn-ed5dUhMovYLH">
