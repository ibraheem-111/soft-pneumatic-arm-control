json); the observer is off (d̂ = 0).&lt;br&gt;&lt;br&gt;Blue: computed by the controller every 10 ms. Dashed: model run inside the controller. Grey: the simulator (make_calibrated_sim). Tip q in mm from the settled pose; pressures in psi." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="110" y="650" width="1300" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="NDOSMC known ref" id="NDOSMC_known_ref"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Delay-aware NDOSMC (M2), reference known" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="grp" value="Controller (every 10 ms, per axis x, y, z)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7F7F7F;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontColor=#555555;arcSize=3;" vertex="1" parent="1"><mxGeometry x="110" y="70" width="1300" height="560" as="geometry"/></mxCell><mxCell id="ref" value="Known trajectory&lt;br&gt;r(t), all t" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="150" y="95" width="150" height="60" as="geometry"/></mxCell><mxCell id="look" value="&lt;b&gt;Look-ahead&lt;/b&gt;&lt;br&gt;r(t+T), ṙ(t+T) read from the trajectory&lt;br&gt;T = 0.5 s (N = 50 steps)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#DCEAF7;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="480" y="90" width="290" height="70" as="geometry"/></mxCell><mxCell id="c1" value="" style="edgeStyle=orthogonalEdgeStyle;ro